{
    "type": "module",
    "name": "better-lyrics",
    "version": "3.0.2.2",
    "description": "Better Lyrics — per-syllable time-synced lyrics for your local music library. A standalone, locally served web player.",
    "scripts": {
        "generate:locales": "tsx tooling/generate-locales.ts",
        "dev": "npm run generate:locales && vite",
        "build": "npm run generate:locales && vite build",
        "preview": "npm run generate:locales && vite preview",
        "start": "node server.mjs",
        "lint": "biome lint --write . && biome format --write .",
        "typecheck": "npm run generate:locales && tsc --noEmit",
        "selfcheck": "tsx tooling/run-selfchecks.ts",
        "check:i18n-brand": "tsx tooling/check-i18n-brand.ts",
        "knip": "knip --cache",
        "knip:fix": "knip --fix",
        "knip:ci": "knip --no-exit-code --reporter github-actions",
        "library": "tsx tooling/build-library.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/better-lyrics/better-lyrics.git"
    },
    "keywords": [
        "lyrics",
        "karaoke",
        "music",
        "web-player",
        "local-library"
    ],
    "author": "boidushya",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/better-lyrics/better-lyrics/issues"
    },
    "homepage": "https://github.com/better-lyrics/better-lyrics#readme",
    "engines": {
        "node": ">=22.12"
    },
    "dependencies": {
        "@braccato/core": "1.20.0",
        "@braccato/parsers": "0.4.1",
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fsegurai/codemirror-theme-material-dark": "^6.2.7",
        "codemirror-lang-rics": "^0.3.22",
        "fast-xml-parser": "^5.12.0",
        "fflate": "^0.8.3",
        "rics": "^0.3.22"
    },
    "devDependencies": {
        "@biomejs/biome": "2.0.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "@typescript/lib-dom": "npm:@types/web@^0.0.280",
        "jsdom": "^30.1.3",
        "knip": "^5.88.1",
        "music-metadata": "^12.3.5",
        "music-metadata-browser": "^2.5.11",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^7.1.0"
    }
}
