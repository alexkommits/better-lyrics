{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "settings.html",
    "editor.html",
    "src/modules/lyrics/lyrics.ts",
    "src/options/dropdownFields.ts",
    "src/options/translationLanguages.ts",
    "src/ui/sortIcon.ts",
    "src/modules/karaoke/karaokeView.ts",
    "src/modules/settings/settings.ts",
    "src/options/editor.ts",
    "src/options/supportStage.ts",
    "src/core/generated/locales.ts",
    "src/**/*.selfcheck.ts",
    "tooling/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tooling/**/*.ts"
  ],
  "ignoreDependencies": [
    "@codemirror/language",
    "@typescript/lib-dom"
  ],
  "ignoreIssues": {
    "src/modules/lyrics/providers/blyrics/blyrics-types.ts": [
      "exports",
      "types"
    ],
    "src/core/generated/locales.ts": [
      "types"
    ]
  }
}
